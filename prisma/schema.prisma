generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  age       Int
  course    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}